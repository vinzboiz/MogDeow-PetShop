@model MOGDEOW.Models.User
@{
    ViewData["Title"] = "Tạo tài khoản mới";
}

@section Styles {
    <link rel="stylesheet" href="~/src/Styles/Pages/UserManage/Create.css" asp-append-version="true" />
}

<div class="create-container">
    <div class="create-header">Tạo tài khoản mới</div>

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">@TempData["Error"]</div>
    }

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <!-- Ảnh đại diện -->
        <div class="form-group">
            <label>Ảnh đại diện:</label>
            <button type="button" class="btn-upload" onclick="document.getElementById('imageInput').click()">📷 Chọn ảnh</button>
            <input type="file" id="imageInput" name="imageFile" accept="image/*" style="display: none;" onchange="previewImage(event)" />
            <div class="preview-wrapper">
                <img id="preview-img" style="display: none;" />
            </div>
        </div>

        <!-- Họ tên -->
        <div class="form-group">
            <label>Họ tên:</label>
            <input asp-for="UserName" class="form-control" required />
        </div>

        <!-- Email -->
        <div class="form-group">
            <label>Email:</label>
            <input asp-for="Email" class="form-control" required />
        </div>

        <!-- Mật khẩu -->
        <div class="form-group">
            <label>Mật khẩu:</label>
            <input asp-for="Password" class="form-control" type="password" required />
        </div>

        <!-- Số điện thoại -->
        <div class="form-group">
            <label>Số điện thoại:</label>
            <input asp-for="PhoneNumber" class="form-control" required />
        </div>

        <!-- Địa chỉ -->
        <div class="form-group">
            <label>Địa chỉ:</label>
            <input asp-for="Address" class="form-control" required />
        </div>

        <!-- Vai trò -->
        <div class="form-group">
            <label>Vai trò:</label>
            <select asp-for="Role" class="form-control" required>
                <option value="Customer">Customer</option>
                <option value="Staff">Staff</option>
                <option value="Admin">Admin</option>
            </select>
        </div>

        <!-- Nút hành động -->
        <div class="form-buttons">
            <button type="submit" class="btn-submit">✅ Tạo tài khoản</button>
            <a asp-action="Index" class="btn-cancel">❌ Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewImage(event) {
            const file = event.target.files[0];
            const preview = document.getElementById('preview-img');
            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.style.display = "block";
            } else {
                preview.src = "";
                preview.style.display = "none";
            }
        }
    </script>
}
