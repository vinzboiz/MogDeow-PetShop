@model MOGDEOW.Models.Product
@using MOGDEOW.Models
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    var productTypes = ViewBag.ProductTypes as List<ProductType>;
}

@section Styles {
    <link rel="stylesheet" href="~/src/Styles/Pages/ProductManage/Add.css" asp-append-version="true" />
}



<form asp-controller="Product" asp-action="Add" method="post" enctype="multipart/form-data" class="form-add">
    <h2 class="title">➕ Thêm sản phẩm mới</h2>
    <!-- Tên -->
    <div class="form-group">
        <label asp-for="ProductName"> Tên Sản Phẩm</label>
        <input asp-for="ProductName" class="form-control" required />
    </div>

    <!-- Giá -->
    <div class="form-group">
        <label asp-for="ProductPrice">Giá</label>
        <input asp-for="ProductPrice" class="form-control" type="number" required />
    </div>

    <!-- Số lượng -->
    <div class="form-group">
        <label asp-for="Quantity">Số Lượng</label>
        <input asp-for="Quantity" class="form-control" type="number" required />
    </div>

    <!-- Đơn vị -->
    <div class="form-group">
        <label asp-for="DVT">Đơn Vị Tính</label>
        <input asp-for="DVT" class="form-control" required />
    </div>

    <!-- Chi tiết -->
    <div class="form-group">
        <label asp-for="ProductDetail">Chi Tiết Sản Phẩm</label>
        <textarea asp-for="ProductDetail" class="form-control" required></textarea>
    </div>

    <!-- Ảnh -->
    <div class="form-group">
        <label>Ảnh sản phẩm:</label>
        <button type="button" class="btn-upload" onclick="document.getElementById('uploadInput').click()">📷 Chọn ảnh</button>
        <input asp-for="Upload" id="uploadInput" type="file" name="Upload" accept="image/*" style="display:none;" onchange="previewImage(event)" required />
        <div class="preview-wrapper">
            <img id="preview-img" style="display: none;" />
        </div>
    </div>

    <!-- Danh mục -->
    <div class="form-group">
        <label asp-for="SelectedTypeName">Danh Mục Sản Phẩm</label>
        <select asp-for="SelectedTypeName" class="form-control" required>
            <option value="">-- Chọn danh mục --</option>
            @foreach (var type in productTypes)
            {
                <option value="@type.ProductTypeName">@type.ProductTypeName</option>
            }
        </select>
    </div>

    <!-- Nút -->
    <div class="form-group mt-4 form-buttons text-center">
        <button type="submit" class="btn-submit">✅ Lưu sản phẩm</button>
        <a asp-action="Manage" class="btn-cancel">🔙 Quay lại</a>
    </div>
</form>

@section Scripts {
    <script>
        function previewImage(event) {
            const file = event.target.files[0];
            const preview = document.getElementById('preview-img');
            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.style.display = "block";
            } else {
                preview.style.display = "none";
            }
        }
    </script>
}
