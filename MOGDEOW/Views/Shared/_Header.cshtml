            }
            else
            {
                <li class="choose-menu-list">
                    <a href="@Url.Action("Login", "User")"> Tài khoản</a>
                </li>
            }
        </ul>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        console.log("Session Debug:");
        console.log("UserName: '@userName'");
        console.log("UserRole: '@userRole'");
    });
</script>
