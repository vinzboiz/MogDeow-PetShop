            </li>
            <!--THU CUNG-->
            <li class="choose-menu-list" id="open-drop-pet">
                <a href="@Url.Action("Index", "Product")" data-category="all-pet">Thú cưng </a>
                <img src="~/src/Assets/Icon/Layout/Header/Pet-Icon.png" alt="Pet-Icon" />
            </li>
            <ul class="dropdown-pet">
                <li class="choose-dropdown-item">
                    <a href="@Url.Action("Index", "Product")" data-category="dog">Chó cảnh</a>
                    <img src="~/src/Assets/Icon/Layout/Header/Dog-icon-Icon.png"
                         alt="Dog icon" />
                </li>
                <li class="choose-dropdown-item">
                    <a href="@Url.Action("Index", "Product")" data-category="cat">Mèo cảnh</a>
                    <img src="~/src/Assets/Icon/Layout/Header/Cat-icon-Icon.png"
                         alt="Cat icon" />
                </li>
            </ul>

            <!--PHU KIEN THU CUNG-->
            <li class="choose-menu-list" id="open-drop-accesories">
                <a href="@Url.Action("Index", "Product")" data-category="all-accessories">Phụ kiện thú cưng</a>
                <img src="~/src/Assets/Icon/Layout/Header/Accessories-Icon.png"
                     alt="Accessories-icon" />
            </li>
            <ul class="dropdown-accesories">
                <li class="choose-dropdown-item">
                    <a href="@Url.Action("Index", "Product")" data-category="food">Thức ăn và thực phẩm dinh dưỡng</a>
                    <img src="~/src/Assets/Icon/Layout/Header/Pet-Food-Icon.png"
                         alt="Pet food icon" />
                </li>
                <li class="choose-dropdown-item">
                    <a href="@Url.Action("Index", "Product")" data-category="hygiene">Vệ sinh và chăm sóc</a>
                    <img src="~/src/Assets/Icon/Layout/Header/Pet-Hygiene-icon.png"
                         alt="Pet-Hygiene" />
                </li>
                <li class="choose-dropdown-item">
                    <a href="@Url.Action("Index", "Product")" data-category="accessories">Đồ dùng, đồ chơi, phụ kiện</a>
                    <img src="~/src/Assets/Icon/Layout/Header/Pet-toy-icon.png"
                         alt="Pet-toy" />
                </li>
                <li class="choose-dropdown-item">
                    <a href="@Url.Action("Index", "Product")" data-category="housing">Chuồng, balo, đệm</a>
                    <img src="~/src/Assets/Icon/Layout/Header/Pet-cushion-icon.png"
                         alt="Pet-cushion" />
                </li>
                <li class="choose-dropdown-item">
                    <a href="@Url.Action("Index", "Product")"  data-category="medicine">Thuốc và thực phẩm chức năng</a>
                    <img src="~/src/Assets/Icon/Layout/Header/Pet-medicine-icon.png"
                         alt="Pet-medicine" />
                </li>
            </ul>

            <!--HO TRO-->
            <li class="choose-menu-list">
                <a href="@Url.Action("Index", "Contact")">Hỗ trợ</a>
                <img src="~/src/Assets/Icon/Layout/Header/Contact-Icon.png"
                     alt="Contact-icon" />
            </li>


            @if (!string.IsNullOrEmpty(userName))
            {
                <hr style="width: 90%; margin: 0px auto;" />
                <li class="choose-menu-list">
                    <span> Xin chào, <strong>@userName</strong>!</span>
                </li>

                <li class="choose-menu-list">
                    <a asp-controller="Account" asp-action="Index"> Thông tin cá nhân</a>
                </li>
                <li class="choose-menu-list">
                    <a class="icon-link" asp-controller="Favourite" asp-action="Index">Yêu Thích</a>
                </li>
                <li class="choose-menu-list">
                    <form method="post" asp-action="Logout" asp-controller="User">
                        <button type="submit" class="dropdown-item logout-btn">Đăng xuất</button>
                    </form>
